; Five concrete, simultaneous witnesses show that each meaningful wrapper path
; is reachable under the same corrected relation used by wrapper-corrected.smt2.
(set-logic ALL)

; A: suppressed + unknown. Suppression bypasses validation and instrumentation.
(declare-const a-suppressed Bool)
(declare-const a-known Bool)
(declare-const a-throws Bool)
(declare-const a-calls Int)
(declare-const a-starts Int)
(declare-const a-ends Int)
(declare-const a-rejects Bool)
(assert (= a-suppressed true))
(assert (= a-known false))
(assert (= a-throws false))
(assert (= a-calls (ite (or a-suppressed a-known) 1 0)))
(assert (= a-starts (ite (and (not a-suppressed) a-known) 1 0)))
(assert (= a-ends a-starts))
(assert (= a-rejects (and (not a-suppressed) (not a-known))))
(assert (! (= a-calls 1) :named suppressed_delegates))
(assert (! (= a-starts 0) :named suppressed_has_no_span))
(assert (! (= a-rejects false) :named suppressed_skips_validation))

; B: unsuppressed + known + return. The target and span complete once.
(declare-const b-suppressed Bool)
(declare-const b-known Bool)
(declare-const b-throws Bool)
(declare-const b-calls Int)
(declare-const b-starts Int)
(declare-const b-ends Int)
(declare-const b-return-identity Bool)
(assert (= b-suppressed false))
(assert (= b-known true))
(assert (= b-throws false))
(assert (= b-calls (ite (or b-suppressed b-known) 1 0)))
(assert (= b-starts (ite (and (not b-suppressed) b-known) 1 0)))
(assert (= b-ends b-starts))
(assert (= b-return-identity (and (or b-suppressed b-known) (not b-throws))))
(assert (! (= b-calls 1) :named return_delegates_once))
(assert (! (= b-starts 1) :named return_starts_span))
(assert (! (= b-ends 1) :named return_ends_span))
(assert (! b-return-identity :named return_preserves_identity))

; C: unsuppressed + known + throw. finally closes the error span.
(declare-const c-suppressed Bool)
(declare-const c-known Bool)
(declare-const c-throws Bool)
(declare-const c-calls Int)
(declare-const c-starts Int)
(declare-const c-ends Int)
(declare-const c-error Bool)
(declare-const c-throw-identity Bool)
(assert (= c-suppressed false))
(assert (= c-known true))
(assert (= c-throws true))
(assert (= c-calls (ite (or c-suppressed c-known) 1 0)))
(assert (= c-starts (ite (and (not c-suppressed) c-known) 1 0)))
(assert (= c-ends c-starts))
(assert (= c-error (and (not c-suppressed) c-known c-throws)))
(assert (= c-throw-identity (and (or c-suppressed c-known) c-throws)))
(assert (! (= c-calls 1) :named throw_delegates_once))
(assert (! (= c-starts 1) :named throw_starts_span))
(assert (! (= c-ends 1) :named throw_ends_span))
(assert (! c-error :named throw_sets_error))
(assert (! c-throw-identity :named throw_preserves_identity))

; D: unsuppressed + unknown. Validation rejects before target/span effects.
(declare-const d-suppressed Bool)
(declare-const d-known Bool)
(declare-const d-throws Bool)
(declare-const d-calls Int)
(declare-const d-starts Int)
(declare-const d-rejects Bool)
(assert (= d-suppressed false))
(assert (= d-known false))
(assert (= d-throws false))
(assert (= d-calls (ite (or d-suppressed d-known) 1 0)))
(assert (= d-starts (ite (and (not d-suppressed) d-known) 1 0)))
(assert (= d-rejects (and (not d-suppressed) (not d-known))))
(assert (! (= d-calls 0) :named unknown_does_not_delegate))
(assert (! (= d-starts 0) :named unknown_has_no_span))
(assert (! d-rejects :named unknown_is_rejected))

; E: suppressed + unknown + throw. Target identity propagates without a span.
(declare-const e-suppressed Bool)
(declare-const e-known Bool)
(declare-const e-throws Bool)
(declare-const e-calls Int)
(declare-const e-starts Int)
(declare-const e-error Bool)
(declare-const e-throw-identity Bool)
(declare-const e-rejects Bool)
(assert (= e-suppressed true))
(assert (= e-known false))
(assert (= e-throws true))
(assert (= e-calls (ite (or e-suppressed e-known) 1 0)))
(assert (= e-starts (ite (and (not e-suppressed) e-known) 1 0)))
(assert (= e-error (and (not e-suppressed) e-known e-throws)))
(assert (= e-throw-identity (and (or e-suppressed e-known) e-throws)))
(assert (= e-rejects (and (not e-suppressed) (not e-known))))
(assert (! (= e-calls 1) :named suppressed_throw_delegates_once))
(assert (! (= e-starts 0) :named suppressed_throw_has_no_span))
(assert (! (= e-error false) :named suppressed_throw_has_no_error_span))
(assert (! e-throw-identity :named suppressed_throw_preserves_identity))
(assert (! (= e-rejects false) :named suppressed_throw_skips_validation))
